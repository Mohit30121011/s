        <servlet-class>com.nlogistic.controller.PortServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PortServlet</servlet-name>
        <url-pattern>/ports</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VesselServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.VesselServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VesselServlet</servlet-name>
        <url-pattern>/vessels</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PricingServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.PricingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PricingServlet</servlet-name>
        <url-pattern>/pricing/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MasterDataServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.MasterDataServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MasterDataServlet</servlet-name>
        <url-pattern>/master-data/*</url-pattern>
    </servlet-mapping>

