    <servlet>
        <servlet-name>ComplianceServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.ComplianceServlet</servlet-class>
        <multipart-config>
            <max-file-size>15728640</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplianceServlet</servlet-name>
        <url-pattern>/compliance</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ComplianceServlet</servlet-name>
        <url-pattern>/compliance/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentViewServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.DocumentViewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentViewServlet</servlet-name>
        <url-pattern>/compliance-document</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.DocumentDownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <url-pattern>/download</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DownloadErrorServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.DownloadErrorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadErrorServlet</servlet-name>
        <url-pattern>/download-errors</url-pattern>
    </servlet-mapping>

    <!-- 10. Billing, Invoicing & Finance Servlets -->
    <servlet>
        <servlet-name>InvoiceServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.InvoiceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InvoiceServlet</servlet-name>
        <url-pattern>/invoices</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>InvoiceServlet</servlet-name>
        <url-pattern>/invoices/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>InvoiceServlet</servlet-name>
        <url-pattern>/invoice-view</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GenerateInvoiceServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.GenerateInvoiceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
