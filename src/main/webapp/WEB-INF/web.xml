        <servlet-name>ClaimServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.ClaimServlet</servlet-class>
        <multipart-config>
            <max-file-size>15728640</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClaimServlet</servlet-name>
        <url-pattern>/claims</url-pattern>
    </servlet-mapping>

