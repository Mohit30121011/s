<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>NLogistic</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Authentication & Security Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.nlogistic.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Mock Payment Gateway & Mobile QR Sync Servlets -->
    <servlet>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.PaymentGatewayServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <url-pattern>/payment/initiate</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <url-pattern>/payment/status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <url-pattern>/payment/pay-mock</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentGatewayServlet</servlet-name>
        <url-pattern>/payment/qr</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MobilePaymentServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.MobilePaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MobilePaymentServlet</servlet-name>
        <url-pattern>/pay-mobile</url-pattern>
    </servlet-mapping>

    <!-- 1. Authentication & User Management Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.RegisterServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <!-- 2. Dashboard & Alert Servlets -->
