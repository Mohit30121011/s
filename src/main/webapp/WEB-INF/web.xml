    </servlet-mapping>

    <servlet>
        <servlet-name>AlertsServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.AlertsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlertsServlet</servlet-name>
        <url-pattern>/alerts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/notifications</url-pattern>
    </servlet-mapping>

    <!-- 3. Admin Servlets -->
