    </servlet>
    <servlet-mapping>
        <servlet-name>AuditLogServlet</servlet-name>
        <url-pattern>/admin/audit-logs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuditApprovalsServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.AuditApprovalsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditApprovalsServlet</servlet-name>
        <url-pattern>/admin/audit-approvals</url-pattern>
    </servlet-mapping>

    <!-- 4. Customer & Partner Servlets -->
    <servlet>
        <servlet-name>CustomerServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.CustomerServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerServlet</servlet-name>
        <url-pattern>/customers</url-pattern>
    </servlet-mapping>

    <!-- 5. Containers & Fleet Servlets -->
    <servlet>
        <servlet-name>ContainerCatalogServlet</servlet-name>
        <servlet-class>com.nlogistic.controller.ContainerCatalogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContainerCatalogServlet</servlet-name>
